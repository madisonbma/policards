{
  "name": "politician_pages_app",
  "version": "1.0.0",
  "description": "desktop app to generate cards and format data",
  "homepage": "https://github.com/madisonbma/policards",
  "bugs": {
    "url": "https://github.com/madisonbma/policards/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madisonbma/policards.git"
  },
  "license": "ISC",
  "author": "madisonbma",
  "type": "commonjs",
  "main": "main.js",
  "build": {
    "appId": "com.cardgenerator.app",
    "productName": "Card Generator",
    "files": [
      "main.js",
      "preload.js",
      "renderer/index.html",
      "renderer/update.html",
      "renderer/styles.css",
      "renderer/update.css",
      "renderer/renderer.js",
      "renderer/update-renderer.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    }
  },
  "scripts": {
    "start": "electron-forge start",
    "test": "echo \"Error: no test specified\" && exit 1",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^39.2.7"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
