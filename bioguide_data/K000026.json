{"usCongressBioId":"K000026","familyName":"Kean","givenName":"Hamilton","middleName":"Fish","unaccentedFamilyName":"Kean","unaccentedGivenName":"Hamilton","unaccentedMiddleName":"Fish","birthDate":"1862","birthCirca":false,"deathDate":"1941","deathCirca":false,"image":[{"contentUrl":"/bioguide-published/assets/65aee9bed46da7bd2d5211a6cc781240.jpg","caption":"Library of Congress"}],"profileText":"(Great-grandfather of Thomas Kean, father of Robert Winthrop Kean, brother of John Kean [1852-1914], and great-grandson of John Kean [1756-1795]), a Senator from New Jersey; born at \"Ursino,\" his ancestral estate near Elizabeth, Union Township, Union County, N.J., February 27, 1862; attended the public schools of Elizabeth, N.J.; graduated from St. Paul's School, Concord, N.H.; engaged in banking and agricultural pursuits; member, Republican National Committee 1919-1928; unsuccessful candidate for the Republican nomination for United States Senator in 1924; elected as a Republican to the United States Senate in 1928 and served from March 4, 1929, to January 3, 1935; unsuccessful candidate for reelection in 1934; engaged in banking until his death in New York City, December 27, 1941; interment in Greenwood Cemetery, Brooklyn, N.Y.","relationship":[],"asset":[{"name":"K000026_001","assetType":"Image","contentUrl":"/bioguide-published/assets/65aee9bed46da7bd2d5211a6cc781240.jpg","creditLine":"Library of Congress","associatedEntity":[],"usageRight":["Import to Congress.gov"],"uploadDate":"2024-06-21T14:38:45.404","uploadDateISO":"2024-06-21T18:38:45.404Z"}],"jobPositions":[{"job":{"name":"Senator","jobType":"CongressMemberJob"},"congressAffiliation":{"congress":{"name":"The 71st United States Congress","congressNumber":71,"congressType":"USCongress","startDate":"1929-03-04","endDate":"1931-03-04"},"partyAffiliation":[{"party":{"name":"Republican"}}],"caucusAffiliation":[{"party":{"name":"Republican"}}],"represents":{"regionType":"StateRegion","regionCode":"NJ"}}},{"job":{"name":"Senator","jobType":"CongressMemberJob"},"congressAffiliation":{"congress":{"name":"The 72nd United States Congress","congressNumber":72,"congressType":"USCongress","startDate":"1931-12-07","endDate":"1933-03-04"},"partyAffiliation":[{"party":{"name":"Republican"}}],"caucusAffiliation":[{"party":{"name":"Republican"}}],"represents":{"regionType":"StateRegion","regionCode":"NJ"}}},{"job":{"name":"Senator","jobType":"CongressMemberJob"},"congressAffiliation":{"congress":{"name":"The 73rd United States Congress","congressNumber":73,"congressType":"USCongress","startDate":"1933-03-04","endDate":"1935-01-03"},"partyAffiliation":[{"party":{"name":"Republican"}}],"caucusAffiliation":[{"party":{"name":"Republican"}}],"represents":{"regionType":"StateRegion","regionCode":"NJ"}},"endCirca":false,"endDate":"1935-01-03"}],"creativeWork":[],"researchRecord":[{"name":"1 letter.","recordType":["Papers"],"recordLocation":{"name":"New Jersey Historical Society","location":{"addressLocality":"Newark","addressRegion":"NJ"}}}],"deleted":false,"publishedDate":"2023-01-09T09:52:12.570","publishedDateISO":"2023-01-09T14:52:12.570Z"}
