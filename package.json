{
  "name": "politicianpages",
  "version": "1.1.1",
  "description": "desktop app to generate cards and format data",
  "homepage": "https://github.com/madisonbma/policards",
  "bugs": {
    "url": "https://github.com/madisonbma/policards/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madisonbma/policards.git"
  },
  "license": "ISC",
  "author": "madisonbma",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "cross-env NODE_ENV=production electron-builder",
    "build:win": "cross-env NODE_ENV=production electron-builder --win",
    "build:mac": "cross-env NODE_ENV=production electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^39.8.8",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.cardgenerator.app",
    "productName": "PoliticianPages",
    "directories": {
      "output": "dist",
      "buildResources": "build" 
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/renderer/**/*",
      "app/assets/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "app/assets/icons/pp_logo.ico",
      "extraResources": [
        {
          "from": "resources/bin/win",
          "to": "bin/win",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "app/assets/fonts",
          "to": "fonts"
        },
        {
          "from": "app/assets/photoshop",
          "to": "photoshop",
          "filter": [
            "**/*.jsx"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "app/assets/icons/pp_logo_1024.icns",
      "extraResources": [
        {
          "from": "resources/bin/mac",
          "to": "bin/mac",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "app/assets/fonts",
          "to": "fonts"
        },
        {
          "from": "app/assets/photoshop",
          "to": "photoshop",
          "filter": [
            "**/*.jsx"
          ]
        }
      ]
    }
  }
}
